# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is gitignored on purpose (see root .gitignore) - never commit it.

project_name = "capstone-phoenix"
environment  = "dev"
aws_region   = "eu-north-1"

# IMPORTANT: replace with YOUR public IP, not 0.0.0.0/0.
# Find it with: curl -s ifconfig.me
allowed_admin_cidrs = ["203.0.113.10/32"]

ssh_user       = "ubuntu"
ssh_public_key = "ssh-ed25519 AAAA... you@yourmachine"
# or: ssh_public_key = file("~/.ssh/id_ed25519.pub")

server_instance_type = "t3.small"
agent_instance_type  = "t3.small"
agent_count          = 2
root_volume_size_gb  = 20
